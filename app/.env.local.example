# Copy to .env.local and fill in. NEVER commit .env.local.
#
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Settings -> API -> service_role (SECRET — server only, bypasses RLS).
# Used solely by server-side API routes / the leads admin page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# A long random string you choose. Required to view /leads.
# Generate: openssl rand -hex 24
LEADS_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional. Extra origins allowed to POST to /api/leads (comma-separated).
# The GitHub Pages site + localhost are allowed by default; add a custom
# domain here once the static site moves to one.
# LEADS_ALLOWED_ORIGINS=https://www.truenest.co.in,https://truenest.co.in
